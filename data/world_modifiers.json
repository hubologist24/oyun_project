        {"type": "conversion", "from_type": "physical", "to_type": "chaos", "percent": 0.35, "scope": "player"}
      ]
    },
    {
      "id": "brittle_bones",
      "name": "Brittle Age",
      "description": "This region's itemization favors precision over raw force.",
      "rules": [
        {"type": "tier_override", "modifier": "physical_damage", "tiers": {"T1": [25, 35], "T2": [15, 24]}}
      ]
    },


    {
  "id": "volatile_death",
