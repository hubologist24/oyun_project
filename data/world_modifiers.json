      "rules": [
        {"type": "damage_dealt_multiplier", "target": "all", "damage_type": "lightning", "multiplier": 1.35}
      ]
    },
    {
      "id": "ashen_frailty",
      "name": "Ashen Frailty",
      "description": "The scorched ground weakens physical resilience.",
      "rules": [
        {"type": "resistance_modifier", "target": "minion", "damage_type": "physical", "delta": -0.15},
        {"type": "tier_override", "modifier": "fire_damage", "tiers": {"T1": [90, 115]}}
      ]
    },
    {
      "id": "corrupted_flesh",
      "name": "Corrupted Flesh",
